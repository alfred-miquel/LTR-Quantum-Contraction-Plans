   "source": [
    "## Dictionary\n",
    "\n",
    "As an alternative, we collect all the information in a dictionary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "d7f70845-ecac-4475-9792-352d5f5117b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "begin\n",
    "              # We create the dictionary and fill it\n",
    "              circuit_dict = Dict{String, Dict{String, Float64}}()\n",
    "\n",
    "                            \n",
    "              for (i, circuit_id) in enumerate(nom_v)\n",
    "                  if length(features_v[i]) != length(feature_names)\n",
    "                      error(\"The features for the circuit $circuit_id are not correct\")\n",
    "                  end\n",
    "\n",
    "                  # this is  an internal dictionary for every circuit\n",
    "                  circuit_features = Dict{String, Float64}()\n",
    "\n",
    "                  for (j, feature_name) in enumerate(feature_names)\n",
    "                      circuit_features[feature_name] = features_v[i][j]\n",
    "                  end\n",
    "\n",
    "                  # join the circuit to the main dictionary\n",
    "                  circuit_dict[circuit_id] = circuit_features\n",
    "              end\n",
    "end"
   ]
  },
