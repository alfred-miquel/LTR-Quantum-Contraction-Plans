   "source": [
    "### Dataframe\n",
    "\n",
    "We also collect the same information in a Dataframe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "03d845aa-a202-472b-845a-da0e96c69024",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       ""
      ]
     },
     "execution_count": 17,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "       using DataFrames\n",
    "\n",
    "       \n",
    "       function create_circuit_dataframe_direct(id_circuits, features_v, feature_names)\n",
    "        \n",
    "           # checking dimensions\n",
    "           if length(id_circuits) != length(features_v)\n",
    "               error(\"El nombre de circuits i features no coincideix\")\n",
    "           end\n",
    "\n",
    "           # DataFrame\n",
    "           df = DataFrame()\n",
    "           df.circuit_name = id_circuits\n",
    "\n",
    "           # filling it with features\n",
    "           for (i, feature_name) in enumerate(feature_names)\n",
    "               df[!, Symbol(feature_name)] = [feature_vector[i] for feature_vector in features_v]\n",
    "           end\n",
    "\n",
    "           return df\n",
    "       end\n",
    "       \n",
    "       \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fc3e30b1-9eb9-4935-ab01-58fb33657ab2",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_circuits = create_circuit_dataframe_direct(nom_v, features_v,feature_names)"
   ]
  },
  
