   "source": [
    "### Getting names and features in two vectors\n",
    "begin\n",
    "     \n",
    "\n",
    "    directori = \"../Data/plans\"\n",
    "    \n",
    "    nom_v = []\n",
    "\n",
    "    features_v=[]\n",
    "\n",
    "\n",
    "    circuit_v = [\"resultats_QFT_5_pla_fc.txt\",\"resultats_QFT_5_pla_gn.txt\",\"resultats_QFT_5_pla_jdrasil.txt\",\"resultats_QFT_5_pla_mf.txt\",\"resultats_QFT_5_pla_minfill_mrs.txt\",\"resultats_QFT_5_pla_minfillbg_mrs.txt\",\"resultats_QFT_5_pla_tamaki.txt\"]        \n",
    "  \n",
    "    for circuit in circuit_v\n",
    "    \n",
    "          try\n",
    "            filename= directori* \"/\" * circuit # if you are using Windows, you should exchange \"/\" by \"\\\\\"\n",
    "            nom= extraure_nom_circuit(circuit)\n",
    "            contractions= get_contractions(filename)\n",
    "            features= get_features_v5(contractions)\n",
    "            push!(nom_v,nom)\n",
    "            push!(features_v, features)\n",
    "\n",
    "           catch\n",
    "               println(\"Error in $circuit\")\n",
    "           end\n",
    "        \n",
    "      \n",
    "    \n",
    "        end\n",
    "\n",
    "end"
   ]
  },
